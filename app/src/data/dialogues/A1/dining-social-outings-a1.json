          "speaker": "Luca",
          "text": "Sì, non ho programmi.",
          "translation": "Yes, I don't have plans.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "non", "translation": ["not"] },
            { "text": "ho", "translation": ["I have"] },
            { "text": "programmi", "translation": ["plans"] }
          ]
        },
        {
          "id": "dining-social-04-line-03",
          "speaker": "Giulia",
          "text": "Vuoi fare un aperitivo?",
