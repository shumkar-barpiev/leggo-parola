            { "text": "lontano", "translation": ["far"] },
            { "text": "da", "translation": ["from"] },
            { "text": "qui", "translation": ["here"] }
          ]
        },
        {
          "id": "dining-social-04-line-07",
          "speaker": "Giulia",
          "text": "No, sono dieci minuti a piedi.",
          "translation": "No, it is ten minutes on foot.",
