            { "text": "sono", "translation": ["they are", "it is"] },
            { "text": "dieci", "translation": ["ten"] },
            { "text": "minuti", "translation": ["minutes"] },
            { "text": "a", "translation": ["by", "on"] },
            { "text": "piedi", "translation": ["feet", "on foot"] }
          ]
        },
        {
          "id": "dining-social-04-line-08",
          "speaker": "Luca",
          "text": "A che ora ci vediamo?",
          "translation": "What time shall we meet?",
          "words": [
            { "text": "A", "translation": ["At"] },
            { "text": "che", "translation": ["what", "which"] },
            { "text": "ora", "translation": ["time", "hour"] },
            { "text": "ci", "translation": ["each other"] },
            { "text": "vediamo", "translation": ["we see", "we meet"] }
          ]
        },
        {
          "id": "dining-social-04-line-09",
          "speaker": "Giulia",
          "text": "Alle sette va bene?",
          "translation": "Is seven okay?",
          "words": [
            { "text": "Alle", "translation": ["At"] },
            { "text": "sette", "translation": ["seven"] },
            { "text": "va", "translation": ["goes", "is"] },
            { "text": "bene", "translation": ["well", "okay"] }
          ]
        },
        {
          "id": "dining-social-04-line-10",
          "speaker": "Luca",
          "text": "Sì, perfetto.",
          "translation": "Yes, perfect.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "perfetto", "translation": ["perfect"] }
          ]
        },
        {
          "id": "dining-social-04-line-11",
          "speaker": "Giulia",
          "text": "Allora ci vediamo alle sette.",
          "translation": "Then we'll see each other at seven.",
          "words": [
            { "text": "Allora", "translation": ["Then", "So"] },
            { "text": "ci", "translation": ["each other"] },
            { "text": "vediamo", "translation": ["we see", "we meet"] },
            { "text": "alle", "translation": ["at"] },
            { "text": "sette", "translation": ["seven"] }
          ]
        }
