          "speaker": "Cameriere",
          "text": "Perfetto, arriva subito.",
          "translation": "Perfect, it will be right out.",
          "words": [
            { "text": "Perfetto", "translation": ["Perfect"] },
            { "text": "arriva", "translation": ["it arrives", "it is coming"] },
            { "text": "subito", "translation": ["right away", "immediately"] }
          ]
        }
      ]
    },

    {
