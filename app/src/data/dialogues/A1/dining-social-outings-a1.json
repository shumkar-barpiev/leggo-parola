            { "text": "avete", "translation": ["you have", "do you have"] },
            { "text": "prenotato", "translation": ["reserved", "booked"] }
          ]
        },
        {
          "id": "dining-social-01-line-02",
          "speaker": "Cliente",
          "text": "No, non abbiamo prenotato.",
          "translation": "No, we do not have a reservation.",
