        },
        {
          "id": "dining-social-01-line-10",
          "speaker": "Cliente",
          "text": "Una bottiglia d'acqua, per favore.",
          "translation": "A bottle of water, please.",
          "words": [
            { "text": "Una", "translation": ["A", "One"] },
            { "text": "bottiglia", "translation": ["bottle"] },
            { "text": "d'acqua", "translation": ["of water"] },
            { "text": "per", "translation": ["for"] },
            { "text": "favore", "translation": ["please", "favor"] }
          ]
