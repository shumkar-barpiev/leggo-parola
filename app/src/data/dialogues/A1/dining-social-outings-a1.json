            { "text": "siamo", "translation": ["we are"] },
            { "text": "in", "translation": ["in"] },
            { "text": "due", "translation": ["two"] }
          ]
        },
        {
          "id": "dining-social-01-line-05",
          "speaker": "Cameriere",
          "text": "Prego, questo è il vostro tavolo.",
