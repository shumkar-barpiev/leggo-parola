          "speaker": "Barista",
          "text": "Sono tre euro e cinquanta.",
          "translation": "It is three euros and fifty cents.",
          "words": [
            { "text": "Sono", "translation": ["they are", "it is"] },
            { "text": "tre", "translation": ["three"] },
            { "text": "euro", "translation": ["euros"] },
            { "text": "e", "translation": ["and"] },
            { "text": "cinquanta", "translation": ["fifty"] }
          ]
        },
        {
          "id": "dining-social-02-line-11",
          "speaker": "Cliente",
          "text": "Ecco, grazie.",
          "translation": "Here you are, thank you.",
          "words": [
            { "text": "Ecco", "translation": ["Here you are", "Here"] },
            { "text": "grazie", "translation": ["thank you", "thanks"] }
          ]
        }
