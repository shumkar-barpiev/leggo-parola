            { "text": "una", "translation": ["a", "one"] },
            { "text": "pizza", "translation": ["pizza"] },
            { "text": "margherita", "translation": ["margherita"] }
          ]
        },
        {
          "id": "dining-social-01-line-09",
          "speaker": "Cameriere",
          "text": "E da bere?",
          "translation": "And to drink?",
          "words": [
            { "text": "E", "translation": ["And"] },
            { "text": "da", "translation": ["to", "for"] },
            { "text": "bere", "translation": ["to drink"] }
