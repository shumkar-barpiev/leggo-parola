            { "text": "volte", "translation": ["times"] },
            { "text": "al", "translation": ["per", "in the"] },
            { "text": "giorno", "translation": ["day"] }
          ]
        },
        {
          "id": "essential-services-01-line-10",
          "speaker": "Farmacista",
          "text": "Due volte al giorno.",
          "translation": "Twice a day.",
          "words": [
