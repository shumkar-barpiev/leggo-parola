            { "text": "possiamo", "translation": ["we can"] },
            { "text": "andare", "translation": ["to go"] },
            { "text": "al", "translation": ["to the"] },
            { "text": "bar", "translation": ["café", "bar"] },
            { "text": "insieme", "translation": ["together"] }
