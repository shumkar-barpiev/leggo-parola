          "speaker": "Anna",
          "text": "Inizia alle nove.",
          "translation": "It starts at nine.",
          "words": [
            { "text": "Inizia", "translation": ["It starts", "begins"] },
            { "text": "alle", "translation": ["at"] },
            { "text": "nove", "translation": ["nine"] }
          ]
        },
        {
          "id": "daily-01-line-09",
          "speaker": "Marco",
          "text": "Dopo la lezione prendi un caffè?",
          "translation": "After the class, are you having a coffee?",
          "words": [
            { "text": "Dopo", "translation": ["After"] },
            { "text": "la", "translation": ["the"] },
            { "text": "lezione", "translation": ["class", "lesson"] },
            { "text": "prendi", "translation": ["you take", "you have"] },
            { "text": "un", "translation": ["a"] },
            { "text": "caffè", "translation": ["coffee"] }
