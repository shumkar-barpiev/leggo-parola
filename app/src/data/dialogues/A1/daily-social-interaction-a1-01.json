            { "text": "come", "translation": ["how"] },
            { "text": "stai", "translation": ["are you", "you are"] }
          ]
        },
        {
          "id": "daily-01-line-02",
          "speaker": "Anna",
          "text": "Ciao Marco, sto bene, grazie.",
          "translation": "Hi Marco, I am well, thank you.",
          "words": [
