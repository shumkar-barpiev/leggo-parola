            { "text": "vivo", "translation": ["I live"] },
            { "text": "con", "translation": ["with"] },
            { "text": "i", "translation": ["the"] },
            { "text": "miei", "translation": ["my"] },
            { "text": "genitori", "translation": ["parents"] }
