{
  "dialogues": [
    {
      "id": "family-relationships-01",
      "title": "Talking About Family",
      "description": "Two people talk about their families.",
      "level": "A1",
      "topic": "family-other-relationships",
      "sourceLanguage": "it",
      "translationLanguage": "en",
      "lines": [
        {
          "id": "family-relationships-01-line-01",
          "speaker": "Anna",
          "text": "Hai fratelli o sorelle?",
          "translation": "Do you have brothers or sisters?",
          "words": [
