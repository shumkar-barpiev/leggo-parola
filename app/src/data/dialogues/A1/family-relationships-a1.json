            { "text": "fratelli", "translation": ["brothers", "siblings"] },
            { "text": "o", "translation": ["or"] },
            { "text": "sorelle", "translation": ["sisters"] }
          ]
        },
        {
          "id": "family-relationships-01-line-02",
          "speaker": "Marco",
          "text": "Sì, ho un fratello.",
          "translation": "Yes, I have one brother.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "ho", "translation": ["I have"] },
            { "text": "un", "translation": ["a", "one"] },
            { "text": "fratello", "translation": ["brother"] }
