          "speaker": "Paolo",
          "text": "Lei vive a Roma.",
          "translation": "She lives in Rome.",
          "words": [
            { "text": "Lei", "translation": ["She"] },
            { "text": "vive", "translation": ["lives"] },
            { "text": "a", "translation": ["in", "at"] },
            { "text": "Roma", "translation": ["Rome"] }
          ]
        },
        {
          "id": "family-relationships-03-line-05",
          "speaker": "Elena",
          "text": "I tuoi genitori lavorano?",
          "translation": "Do your parents work?",
          "words": [
