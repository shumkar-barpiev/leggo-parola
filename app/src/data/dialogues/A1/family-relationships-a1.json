          "speaker": "Anna",
          "text": "Come si chiama?",
          "translation": "What is his name?",
          "words": [
            { "text": "Come", "translation": ["how", "what"] },
            { "text": "si", "translation": ["himself"] },
            { "text": "chiama", "translation": ["is called", "his name is"] }
          ]
        },
        {
          "id": "family-relationships-01-line-04",
          "speaker": "Marco",
          "text": "Si chiama Davide.",
          "translation": "His name is Davide.",
          "words": [
            { "text": "Si", "translation": ["himself"] },
            { "text": "chiama", "translation": ["is called", "his name is"] },
            { "text": "Davide", "translation": ["Davide"] }
          ]
        },
        {
          "id": "family-relationships-01-line-05",
          "speaker": "Anna",
          "text": "Quanti anni ha?",
          "translation": "How old is he?",
          "words": [
            { "text": "Quanti", "translation": ["how many"] },
            { "text": "anni", "translation": ["years"] },
            { "text": "ha", "translation": ["has", "is"] }
          ]
        },
        {
          "id": "family-relationships-01-line-06",
          "speaker": "Marco",
          "text": "Ha ventidue anni.",
          "translation": "He is twenty-two years old.",
          "words": [
            { "text": "Ha", "translation": ["has", "he is"] },
            { "text": "ventidue", "translation": ["twenty-two"] },
            { "text": "anni", "translation": ["years"] }
          ]
        },
        {
          "id": "family-relationships-01-line-07",
          "speaker": "Anna",
          "text": "Vive con te?",
          "translation": "Does he live with you?",
          "words": [
            { "text": "Vive", "translation": ["he lives", "does he live"] },
            { "text": "con", "translation": ["with"] },
            { "text": "te", "translation": ["you"] }
          ]
        },
        {
          "id": "family-relationships-01-line-08",
          "speaker": "Marco",
          "text": "No, vive a Bologna.",
          "translation": "No, he lives in Bologna.",
          "words": [
            { "text": "No", "translation": ["No"] },
            { "text": "vive", "translation": ["he lives"] },
            { "text": "a", "translation": ["in", "at"] },
            { "text": "Bologna", "translation": ["Bologna"] }
          ]
        },
        {
          "id": "family-relationships-01-line-09",
          "speaker": "Anna",
          "text": "Lo vedi spesso?",
          "translation": "Do you see him often?",
          "words": [
            { "text": "Lo", "translation": ["him"] },
            { "text": "vedi", "translation": ["you see", "do you see"] },
            { "text": "spesso", "translation": ["often"] }
          ]
        },
        {
          "id": "family-relationships-01-line-10",
          "speaker": "Marco",
          "text": "Sì, lo vedo nel fine settimana.",
          "translation": "Yes, I see him on the weekend.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "lo", "translation": ["him"] },
            { "text": "vedo", "translation": ["I see"] },
            { "text": "nel", "translation": ["in the", "on the"] },
            { "text": "fine", "translation": ["end"] },
            { "text": "settimana", "translation": ["week"] }
          ]
        }
      ]
    },
    {
