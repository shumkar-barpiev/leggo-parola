          "words": [
            { "text": "Chi", "translation": ["Who"] },
            { "text": "è", "translation": ["is"] },
            { "text": "Matteo", "translation": ["Matteo"] }
          ]
        },
        {
          "id": "family-relationships-04-line-02",
          "speaker": "Davide",
          "text": "È un mio amico.",
          "translation": "He is a friend of mine.",
          "words": [
            { "text": "È", "translation": ["He is", "is"] },
            { "text": "un", "translation": ["a"] },
            { "text": "mio", "translation": ["my", "mine"] },
            { "text": "amico", "translation": ["friend"] }
          ]
        },
        {
          "id": "family-relationships-04-line-03",
          "speaker": "Chiara",
          "text": "Da quanto tempo lo conosci?",
          "translation": "How long have you known him?",
          "words": [
            { "text": "Da", "translation": ["for", "since"] },
            { "text": "quanto", "translation": ["how much", "how long"] },
            { "text": "tempo", "translation": ["time"] },
            { "text": "lo", "translation": ["him"] },
            { "text": "conosci", "translation": ["you know"] }
          ]
        },
        {
          "id": "family-relationships-04-line-04",
          "speaker": "Davide",
          "text": "Lo conosco da cinque anni.",
          "translation": "I have known him for five years.",
          "words": [
            { "text": "Lo", "translation": ["him"] },
            { "text": "conosco", "translation": ["I know"] },
            { "text": "da", "translation": ["for", "since"] },
            { "text": "cinque", "translation": ["five"] },
            { "text": "anni", "translation": ["years"] }
          ]
        },
        {
          "id": "family-relationships-04-line-05",
          "speaker": "Chiara",
          "text": "Dove vi siete conosciuti?",
          "translation": "Where did you meet?",
          "words": [
            { "text": "Dove", "translation": ["Where"] },
            { "text": "vi", "translation": ["each other"] },
            { "text": "siete", "translation": ["you have", "you are"] },
            { "text": "conosciuti", "translation": ["met", "known"] }
          ]
        },
        {
          "id": "family-relationships-04-line-06",
          "speaker": "Davide",
          "text": "A scuola.",
          "translation": "At school.",
          "words": [
            { "text": "A", "translation": ["At"] },
            { "text": "scuola", "translation": ["school"] }
          ]
        },
        {
          "id": "family-relationships-04-line-07",
          "speaker": "Chiara",
          "text": "Abita vicino a te?",
          "translation": "Does he live near you?",
          "words": [
            { "text": "Abita", "translation": ["he lives", "does he live"] },
            { "text": "vicino", "translation": ["near", "close"] },
            { "text": "a", "translation": ["to"] },
            { "text": "te", "translation": ["you"] }
          ]
        },
        {
          "id": "family-relationships-04-line-08",
          "speaker": "Davide",
          "text": "Sì, abita nella stessa zona.",
          "translation": "Yes, he lives in the same area.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "abita", "translation": ["he lives"] },
            { "text": "nella", "translation": ["in the"] },
            { "text": "stessa", "translation": ["same"] },
            { "text": "zona", "translation": ["area"] }
          ]
        },
        {
          "id": "family-relationships-04-line-09",
          "speaker": "Chiara",
          "text": "Vi vedete spesso?",
          "translation": "Do you see each other often?",
          "words": [
            { "text": "Vi", "translation": ["each other"] },
            { "text": "vedete", "translation": ["you see", "do you see"] },
            { "text": "spesso", "translation": ["often"] }
          ]
        },
        {
          "id": "family-relationships-04-line-10",
          "speaker": "Davide",
          "text": "Sì, usciamo spesso insieme.",
          "translation": "Yes, we often go out together.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "usciamo", "translation": ["we go out"] },
            { "text": "spesso", "translation": ["often"] },
            { "text": "insieme", "translation": ["together"] }
          ]
        },
        {
          "id": "family-relationships-04-line-11",
          "speaker": "Chiara",
          "text": "Sembra simpatico.",
          "translation": "He seems nice.",
          "words": [
            { "text": "Sembra", "translation": ["he seems", "seems"] },
            { "text": "simpatico", "translation": ["nice", "friendly"] }
          ]
        }
      ]
    },
    {
      "id": "family-relationships-05",
      "title": "Visiting Grandparents",
      "description": "Two people talk about visiting grandparents on Sunday.",
      "level": "A1",
      "topic": "family-other-relationships",
      "sourceLanguage": "it",
      "translationLanguage": "en",
      "lines": [
        {
          "id": "family-relationships-05-line-01",
          "speaker": "Marta",
          "text": "Cosa fai domenica?",
          "translation": "What are you doing on Sunday?",
          "words": [
            { "text": "Cosa", "translation": ["What"] },
            { "text": "fai", "translation": ["you do", "are you doing"] },
            { "text": "domenica", "translation": ["Sunday"] }
          ]
        },
        {
          "id": "family-relationships-05-line-02",
          "speaker": "Andrea",
          "text": "Vado dai miei nonni.",
          "translation": "I am going to my grandparents' house.",
          "words": [
            { "text": "Vado", "translation": ["I go", "I am going"] },
            { "text": "dai", "translation": ["to the", "at the home of"] },
            { "text": "miei", "translation": ["my"] },
            { "text": "nonni", "translation": ["grandparents"] }
          ]
        },
        {
          "id": "family-relationships-05-line-03",
          "speaker": "Marta",
          "text": "Dove abitano?",
          "translation": "Where do they live?",
          "words": [
            { "text": "Dove", "translation": ["Where"] },
            { "text": "abitano", "translation": ["they live", "do they live"] }
          ]
        },
        {
          "id": "family-relationships-05-line-04",
          "speaker": "Andrea",
          "text": "Abitano fuori città.",
          "translation": "They live outside the city.",
          "words": [
            { "text": "Abitano", "translation": ["They live"] },
            { "text": "fuori", "translation": ["outside"] },
            { "text": "città", "translation": ["city"] }
          ]
        },
        {
          "id": "family-relationships-05-line-05",
          "speaker": "Marta",
          "text": "Vai spesso da loro?",
          "translation": "Do you visit them often?",
          "words": [
            { "text": "Vai", "translation": ["you go", "do you go"] },
            { "text": "spesso", "translation": ["often"] },
            { "text": "da", "translation": ["to", "at"] },
            { "text": "loro", "translation": ["them", "their place"] }
          ]
        },
        {
          "id": "family-relationships-05-line-06",
          "speaker": "Andrea",
          "text": "Sì, una volta al mese.",
          "translation": "Yes, once a month.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "una", "translation": ["one", "a"] },
            { "text": "volta", "translation": ["time", "once"] },
            { "text": "al", "translation": ["per", "in the"] },
            { "text": "mese", "translation": ["month"] }
          ]
        },
