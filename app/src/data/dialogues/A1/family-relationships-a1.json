          "words": [
            { "text": "Cosa", "translation": ["What"] },
            { "text": "fate", "translation": ["you do", "do you do"] },
            { "text": "insieme", "translation": ["together"] }
          ]
        },
        {
          "id": "family-relationships-05-line-08",
          "speaker": "Andrea",
          "text": "Pranziamo e parliamo molto.",
          "translation": "We have lunch and talk a lot.",
          "words": [
            { "text": "Pranziamo", "translation": ["we have lunch"] },
            { "text": "e", "translation": ["and"] },
            { "text": "parliamo", "translation": ["we talk"] },
            { "text": "molto", "translation": ["a lot", "much"] }
          ]
        },
        {
          "id": "family-relationships-05-line-09",
          "speaker": "Marta",
          "text": "Tua nonna cucina?",
