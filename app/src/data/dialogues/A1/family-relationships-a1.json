    {
      "id": "family-relationships-04",
      "title": "Talking About a Friend",
      "description": "Two people talk about a close friend.",
      "level": "A1",
      "topic": "family-other-relationships",
      "sourceLanguage": "it",
      "translationLanguage": "en",
      "lines": [
        {
          "id": "family-relationships-04-line-01",
          "speaker": "Chiara",
