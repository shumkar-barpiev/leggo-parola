          "speaker": "Giulia",
          "text": "Ho diciannove anni.",
          "translation": "I am nineteen years old.",
          "words": [
            { "text": "Ho", "translation": ["I have", "I am"] },
            { "text": "diciannove", "translation": ["nineteen"] },
            { "text": "anni", "translation": ["years"] }
          ]
        },
        {
          "id": "family-relationships-02-line-08",
          "speaker": "Sara",
          "text": "Studi anche tu?",
          "translation": "Do you study too?",
          "words": [
            { "text": "Studi", "translation": ["you study", "do you study"] },
            { "text": "anche", "translation": ["also", "too"] },
            { "text": "tu", "translation": ["you"] }
          ]
        },
        {
          "id": "family-relationships-02-line-09",
          "speaker": "Giulia",
          "text": "Sì, studio economia.",
          "translation": "Yes, I study economics.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "studio", "translation": ["I study"] },
            { "text": "economia", "translation": ["economics"] }
          ]
        },
        {
          "id": "family-relationships-02-line-10",
          "speaker": "Sara",
          "text": "Molto interessante.",
          "translation": "Very interesting.",
          "words": [
            { "text": "Molto", "translation": ["very", "much"] },
            { "text": "interessante", "translation": ["interesting"] }
          ]
        },
        {
          "id": "family-relationships-02-line-11",
          "speaker": "Giulia",
          "text": "Grazie.",
          "translation": "Thank you.",
          "words": [
            { "text": "Grazie", "translation": ["Thank you", "Thanks"] }
          ]
        }
      ]
    },
    {
