          "words": [
            { "text": "Tua", "translation": ["Your"] },
            { "text": "nonna", "translation": ["grandmother"] },
            { "text": "cucina", "translation": ["cooks", "does she cook"] }
          ]
        },
        {
          "id": "family-relationships-05-line-10",
          "speaker": "Andrea",
          "text": "Sì, cucina molto bene.",
          "translation": "Yes, she cooks very well.",
          "words": [
            { "text": "Sì", "translation": ["Yes"] },
            { "text": "cucina", "translation": ["she cooks"] },
            { "text": "molto", "translation": ["very", "a lot"] },
            { "text": "bene", "translation": ["well"] }
          ]
        },
        {
          "id": "family-relationships-05-line-11",
