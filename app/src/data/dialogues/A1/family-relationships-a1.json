        },
        {
          "id": "family-relationships-02-line-05",
          "speaker": "Luca",
          "text": "No, Giulia è più giovane.",
          "translation": "No, Giulia is younger.",
          "words": [
            { "text": "No", "translation": ["No"] },
            { "text": "Giulia", "translation": ["Giulia"] },
            { "text": "è", "translation": ["is"] },
            { "text": "più", "translation": ["more"] },
            { "text": "giovane", "translation": ["young", "younger"] }
          ]
        },
        {
          "id": "family-relationships-02-line-06",
          "speaker": "Sara",
          "text": "Quanti anni hai?",
          "translation": "How old are you?",
          "words": [
            { "text": "Quanti", "translation": ["how many"] },
            { "text": "anni", "translation": ["years"] },
            { "text": "hai", "translation": ["you have", "are you"] }
